# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Local tool/editor config, not part of the project
.claude/
.commandcode/

# Prior project attempt, superseded and excluded from the public repo (see README)
archive/

# Trained checkpoints are large binaries; hosted on Hugging Face Hub instead (see checkpoints/README.md)
checkpoints/*.pt

# Cached/regeneratable corpus data; provenance hashes are kept in each
# cache directory's metadata.json, which stays tracked. Covers per-dataset-config
# caches (data_v3/, data_v3_103/, ...) created by --dataset-cache-dir.
data_v3*/*.pt
data_v3*/tokenizer.json

# Local experiment-tracking store written by `wandb` (offline or synced).
wandb/
